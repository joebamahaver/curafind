# Local scoring and eligibility via Ollama 0.35+ (ollama pull tev1:4b).
OLLAMA_BASE_URL=http://127.0.0.1:11434
DECISIONS_MODEL=tev1:4b
DECISIONS_TIMEOUT_MS=120000

# Cloud question generation and trial ranking still use Strands.
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional: enables Cerebras Qwen in the trial-ranking model rotation.
CEREBRAS_API_KEY=

# Maximum number of abstracts sent to evaluateStudy per drug search.
DRUG_EVAL_LIMIT=5
# Number of ranked drug studies displayed in the browser.
DRUG_DISPLAY_LIMIT=2

# Trials retrieved and scored per search page (10-1000; default 10).
TRIAL_SEARCH_LIMIT=10
# Highest-scoring trials kept for eligibility questions (1-1000; default 3).
TRIAL_SHORTLIST_LIMIT=3
